# =========================================================
# HRC-CEMS | Plantilla de variables de entorno
# =========================================================
# Copiar como .env y rellenar con los valores reales:
#     copy .env.example .env        (Windows)
#
# El archivo .env NO se versiona: contiene rutas y credenciales locales.
# Hay que recrearlo en cada maquina.
# =========================================================

# --- Credenciales de Google (service account con acceso al Sheet "EEMM") ---
# Ruta relativa a la raiz del proyecto. El archivo JSON tampoco se versiona.
GOOGLE_CREDENTIALS_PATH=secrets/credentials.json

# --- Fuente Excel: hojas de vida de equipos ---
# Ruta al .xlsm de origen. Absoluta o relativa a la raiz. UNA sola linea:
# si la variable se declara dos veces, gana la ultima y la otra se pierde.
#
# Esta ruta CAMBIA SEGUN LA MAQUINA:
#   - servidor:  el archivo ORIGINAL en la unidad de red, que la unidad edita a diario
#                EXCEL_HOJA_DE_VIDA_PATH=Y:/PMP Y HOJAS DE VIDA/HOJAS_DE_VIDA.xlsm
#   - desarrollo: una copia local
EXCEL_HOJA_DE_VIDA_PATH=data/raw/excel/HOJAS_DE_VIDA.xlsm

# --- Base de datos ---
# PostgreSQL, mismo motor en desarrollo y en el hospital (el esquema usa
# NULLS NOT DISTINCT, columnas generadas y disparadores plpgsql).
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/hrc_cems

# --- Aplicacion Flask ---
# Clave de sesion: generar una propia para el despliegue, no reutilizar esta.
SECRET_KEY=cambiar-esta-clave-en-produccion
FLASK_ENV=development
FLASK_DEBUG=1

# Host y puerto. 0.0.0.0 expone el servidor a la LAN del hospital.
APP_HOST=127.0.0.1
APP_PORT=5000

# --- Registro de actividad ---
LOG_LEVEL=INFO
